APP_NAME=VLM-to-LLM Cost Reduction
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Provider: gemini, groq, or bedrock
LLM_PROVIDER=gemini
VLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_VLM_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_LLM_MODEL=
GROQ_VLM_MODEL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_LLM_MODEL_ID=
BEDROCK_VLM_MODEL_ID=

# Local vision models
YOLO_MODEL_PATH=models/yolo26n_openvino_model
YOLO_WEIGHTS_PATH=models/yolo26n.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=intel:cpu
PADDLEOCR_LANGUAGE=en

# Upload and evaluation
MAX_UPLOAD_SIZE_MB=15
RESULTS_DB_PATH=data/results.sqlite3
PRICING_CONFIG_PATH=config/model_pricing.json
